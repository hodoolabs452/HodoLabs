# ==============================================================================
# HODOLABS WEBSITE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit actual production API keys to version control.
# ==============================================================================

# Contact Form Email Delivery (Sends to hello@hodoolabs.com)
# Option 1: Resend (Recommended)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="HodoLabs <onboarding@resend.dev>" # Or verified domain: "HodoLabs <contact@hodoolabs.com>"
# EMAIL_TO="hello@hodoolabs.com"

# Option 2: SendGrid
# SENDGRID_API_KEY="SG.placeholder"

# Option 3: Postmark
# POSTMARK_SERVER_TOKEN="placeholder"
