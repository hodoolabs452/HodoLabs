# ==============================================================================
# HODOLABS WEBSITE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these environment variables in your Vercel Project Settings.
# NEVER commit actual production API keys or passwords to version control.
# ==============================================================================

# ==============================================================================
# CONTACT FORM EMAIL CONFIGURATION (Delivers to hello@hodoolabs.com)
# Choose EITHER Option 1 (Resend - Recommended) OR Option 2 (SMTP).
# ==============================================================================

# --- OPTION 1: Resend (Recommended for Next.js on Vercel) ---
# 1. Sign up at https://resend.com and generate an API key.
# 2. To send from your domain, verify hodoolabs.com at https://resend.com/domains
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="HodoLabs <contact@hodoolabs.com>"
# EMAIL_TO="hello@hodoolabs.com"

# --- OPTION 2: Standard SMTP (Google Workspace / Microsoft 365 / Zoho / Custom SMTP) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="hello@hodoolabs.com"
# SMTP_PASSWORD="your-app-password-or-smtp-password"
# EMAIL_FROM="HodoLabs <hello@hodoolabs.com>"
# EMAIL_TO="hello@hodoolabs.com"

# --- OPTION 3: SendGrid (Alternative API) ---
# SENDGRID_API_KEY="SG.placeholder"

# --- OPTION 4: Postmark (Alternative API) ---
# POSTMARK_SERVER_TOKEN="placeholder"
